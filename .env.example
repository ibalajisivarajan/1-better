# ── Frontend (Vite public vars — safe to expose in browser) ────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Supabase Edge Function secrets (set via: supabase secrets set KEY=value) ─
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase runtime
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:alabinnexus@gmail.com
CRON_SECRET=generate-a-random-32-char-string-here

# ── GitHub Actions secrets (add in repo Settings → Secrets → Actions) ────────
# SEND_NUDGES_URL=https://your-project-ref.supabase.co/functions/v1/send-nudges
# CRON_SECRET=same-value-as-above
